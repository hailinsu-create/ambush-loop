#!/usr/bin/env bash
set -euo pipefail
args=(); count=0
for arg in "$@"; do
 if [[ "$arg" == res://scripts/visual_snapshot_test.gd ]]; then
  args+=(res://scripts/hud_old_record_external.gd); count=$((count+1))
 else args+=("$arg"); fi
done
[[ "$count" == 1 ]] || exit 2
exec /workspace/.ambush-loop-env/godot/4.7.2/Godot_v4.7.2-stable_linux.x86_64 --audio-driver Dummy "${args[@]}"
