#!/usr/bin/env bash
set -euo pipefail
args=(); count=0
for arg in "$@"; do
 if [[ "$arg" == res://scripts/storage_probe.gd ]]; then
  args+=(res://scripts/contract_diff_reader.gd); count=$((count+1))
 else args+=("$arg"); fi
done
[[ "$count" == 1 ]] || exit 2
exec /workspace/.ambush-loop-env/godot/4.7.2/Godot_v4.7.2-stable_linux.x86_64 --audio-driver Dummy "${args[@]}"
