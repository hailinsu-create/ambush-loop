; Engine configuration file.
; Ambush VS skeleton — Godot 4.7.2. Not a playable vertical slice yet.
config_version=5

[application]

config/name="Ambush Loop"
config/version="0.7.0-vs"
config/description="Ambush VS yard greybox (W3). Same Android applicationId as 0.6.28 for future overlay upgrade tests."
run/main_scene="res://scenes/greybox.tscn"
config/features=PackedStringArray("4.7", "Mobile", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0
window/size/mode=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.05, 1)
textures/vram_compression/import_etc2_astc=true
