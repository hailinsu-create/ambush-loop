  "plans": [
    {
      "id": "WA",
      "label": "货台宽扇压制",
      "expect": "win",
      "trigger": {
        "type": "manual"
      },
      "t0_s": 26,
      "notes": "MG42@货台(5,10) 宽扇封长廊与东门；MP40@近门(19,10) 补盲区；第三人是预设爆点手。"
    },
    {
      "id": "WB",
      "label": "窄扇点杀+爆点封后",
      "expect": "win",
      "trigger": {
        "type": "mine_detonate",
        "bind": "mine_door"
      },
      "t0_s": 27,
      "notes": "Kar98k@货台(5,10) 点杀纵队；地雷(16,8)/(20,11) 与手雷(16.5,8)/(20,11) 封后。"
    },
    {
      "id": "F-WA30",
      "label": "A 货台射手 +30°",
      "expect": "lose",
      "notes": "朝向反例：宽扇转向北，主廊无人压制，4 人从东门漏网。"
    },
    {
      "id": "T-WA-4",
      "label": "A 提前 4s 起爆",
      "expect": "lose",
      "notes": "时机反例：尾兵尚未进入货台射程，1 人漏网。"
    },
    {
      "id": "W-WA-MG→Kar",
      "label": "A 把 MG42 换成 Kar98k",
      "expect": "lose",
      "notes": "换枪反例：窄扇点杀压不住纵队，4 人漏网。"
    },
    {
      "id": "S-WA-no-dock",
      "label": "A 未占货台高点",
      "expect": "lose",
      "notes": "未侦察/错位反例：只守近门，主廊全漏。"
    }
  ],
